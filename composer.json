{
    "name": "rtiglobal/phpqdrv",
    "description": "A simple queue system supporting multiple backends for PHP",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-pdo": "*",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "pda/pheanstalk": "^5.0 || ^6.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0",
        "predis/predis": "^2.2"
    },
    "suggest": {
        "ext-pcntl": "Graceful worker shutdown on SIGTERM/SIGINT",
        "ext-pdo_mysql": "For the MariaDB queue driver",
        "ext-pdo_pgsql": "For the PostgreSQL queue driver",
        "ext-pdo_sqlite": "For the SQLite queue driver",
        "pda/pheanstalk": "For the Beanstalkd queue driver",
        "predis/predis": "For the Redis queue driver"
    },
    "autoload": {
        "psr-4": {
            "RTIGLOBAL\\Phpqdrv\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RTIGLOBAL\\Phpqdrv\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "check": ["@test", "@stan"]
    },
    "config": {
        "sort-packages": true
    },
    "authors": [
        {
            "name": "Tudor Rusu",
            "email": "contact@rtiglobal.services"
        }
    ]
}
